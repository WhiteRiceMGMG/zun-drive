## 4.検討用ソフト
	
	init関数
	{
	    シフト遷移要求 ← シフトニュートラル要求
	    確定シフト遷移先 ← ニュートラル
	    シフト遷移先前回値 ← ニュートラル
	}
	
	16ms関数
	{
	    シフト遷移要求_ワーク ← シフト要求調停関数返り値
	    シフト遷移調停関数コール( シフト遷移要求_ワーク )
	}
	
	シフト要求調停関数
	{
	    if ( ギア最新値 == ニュートラル )  /* 優先度考慮 */
	    {
	        シフト遷移要求 ← シフトニュートラル要求
	    }
	    else if ( ギア最新値 == リバース ) /* 優先度考慮 */
	    {
	        シフト遷移要求 ← シフトリバース要求
	    }
	    else if ( ギア最新値 > ギア前回値 )
	    {
	        シフト遷移要求 ← シフトアップ要求
	    }
	    else if (ギア最新値 < ギア前回値 )
	    {
	        シフト遷移要求 ← シフトダウン要求
	    }
	    else 
	    {
	        ;
	    }
	    return シフト遷移要求_ワーク
	}

	シフト遷移調停関数( シフト遷移要求_ワーク )
	{
	    シフト遷移許可_ワーク = OFF;  /* 遷移なし */
	    switch ( シフト遷移要求_ワーク ) /* シフト遷移許可の値によって処理を切り替える */
	    {
	        case シフトニュートラル要求;
	            シフト遷移許可_ワーク ← ON
	            break;
	        case シフトリバース要求:
	            if ( ( 車速 < 5km/h )
	              && ( クラッチ開度 > 90% )
	              && ( アクセル開度 < 5% ) )
	            {
	                シフト遷移許可_ワーク ← ON
	            }
	            break;
	        case シフトアップ要求:
	            if ( ギア最新値 == ニュートラル ) /* ニュートラルからのシフトアップは常に許可 */
	            {
	                シフト遷移許可_ワーク ← ON
	            }
	            else /* ニュートラル以外のギアからシフトアップするとき */
	            {
	                if ( ( クラッチ開度 > 80% )
	                  && ( エンジン回転数 > 1500rpm )
	                  && ( アクセル開度 < 10% ) )
	                {
	                    シフト遷移許可_ワーク ← ON
	                }
	            }
	            break;
	        case シフトダウン要求:
	            ターゲット先回転数 = 車速 x ギア比 x ファイナル比 x 単位変換係数(km/h→rpm)
	            if ( (クラッチ開度 > 80% )
	              && ( ターゲット先回転数 < 上限回転数 ) )
	            {
	                シフト遷移許可_ワーク ← ON
	            }
	            break;
	        default:
	            ;  /* 何もしない */
	            break;
	    }
	    if ( シフト遷移許可_ワーク == ON ) /* シフト遷移許可時 */
	    {
	        確定シフト遷移先 = ギア最新値
	        ギア前回値 = ギア最新値
	    }
	    else /* シフト遷移未許可時 */
	    {
	        /* 確定シフト遷移先 = ギア最新値 */ /* 処理なし時と同様のふるまいのためコメントアウト */
	    }
	}


